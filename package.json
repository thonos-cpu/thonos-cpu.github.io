{
  "name": "tasis-portfolio",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Personal portfolio for Athanasios Tasis — static, build-time GitHub data, deployed to GitHub Pages.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test:security": "node --test tests/security.test.mjs",
    "test:site": "node --test tests/site.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "test:browser": "playwright test",
    "test:unit": "node --experimental-strip-types --test tests/unit/*.test.mjs",
    "test:all": "npm run test:security && npm run test:unit && npm run check && npm run lint && npm run build && npm run test:site && npm run test:browser"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.6",
    "astro": "^7.4.13",
    "lenis": "^1",
    "lightningcss": "^1.33.0",
    "pyodide": "^314.0.8",
    "sanitize-html": "^2",
    "sql.js": "^1.16.0",
    "wasmoon": "^1.16.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9",
    "@eslint/js": "^9",
    "@fontsource-variable/geist": "^5",
    "@fontsource-variable/geist-mono": "^5",
    "@types/sanitize-html": "^2",
    "@types/sql.js": "^1.4.11",
    "eslint": "^10",
    "eslint-plugin-astro": "^3",
    "github-markdown-css": "^5",
    "prettier": "^3",
    "prettier-plugin-astro": "^1.1",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "@playwright/test": "1.65.1",
    "@axe-core/playwright": "4.14.0"
  }
}
